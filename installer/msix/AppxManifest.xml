  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pt-BR" />
    <Resource Language="es" />
  </Resources>
  <Applications>
    <Application Id="Aprint" Executable="Aprint.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Aprint"
                          Description="Capture, annotate, redact, and share screenshots."
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          BackgroundColor="transparent" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="Aprint.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="AprintStartup" Enabled="false" DisplayName="Aprint" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
